        "# ===== CELL 1: setup, data, architecture (architecture identical to your notebook) =====\n",
        "import os, gc, time, shutil, warnings\n",
        "import numpy as np, pandas as pd\n",
        "import tensorflow as tf\n",
        "from tensorflow import keras\n",
        "from tensorflow.keras import layers\n",
        "\n",
        "try:\n",
        "    from google.colab import drive\n",
        "    drive.mount(\"/content/drive\")\n",
        "    DRIVE = \"/content/drive/MyDrive\"\n",
        "except ImportError:                      # not on Colab (only used for offline testing)\n",
        "    DRIVE = os.environ.get(\"DRIVE_DIR\", \".\")\n",
        "\n",
        "BM = [\"iccad1\", \"iccad2\", \"iccad3\", \"iccad4\", \"iccad5\"]\n",
        "loaded = np.load(f\"{DRIVE}/iccad12_processed.npz\")\n",
        "DATA = {}\n",
        "def get_split(bm, split):\n",
        "    k = (bm, split)\n",
        "    if k not in DATA:                    # cache: np.load on an .npz re-reads the file on every access\n",
        "        X = loaded[f\"{bm}_X_{split}\"].astype(\"float32\")\n",
        "        y = loaded[f\"{bm}_y_{split}\"].reshape(-1).astype(\"int32\")\n",
        "        DATA[k] = (X, y)\n",
        "    return DATA[k]\n",
        "\n",
        "# Safety: keep a copy of your original results. Nothing in this notebook touches that file.\n",
        "OLD = f\"{DRIVE}/full_metrics_results.csv\"\n",
        "BAK = f\"{DRIVE}/full_metrics_results_BACKUP.csv\"\n",
        "if os.path.exists(OLD) and not os.path.exists(BAK):\n",
        "    shutil.copy(OLD, BAK)\n",
        "\n",
        "def build_baseline_cnn(input_shape=(64, 64, 1)):\n",
        "    inputs = keras.Input(shape=input_shape)\n",
        "    x = layers.Conv2D(12, (3,3), activation=\"elu\", padding=\"same\")(inputs)\n",
        "    x = layers.Conv2D(12, (3,3), activation=\"elu\", padding=\"same\")(x)\n",
        "    x = layers.Conv2D(12, (3,3), activation=None, padding=\"same\")(x)\n",
        "    x = layers.BatchNormalization(momentum=0.99, epsilon=0.001)(x)\n",
        "    x = layers.Activation(\"elu\")(x)\n",
        "    x = layers.MaxPooling2D((2,2))(x)\n",
        "    x = layers.Conv2D(12, (3,3), activation=\"elu\", padding=\"same\")(x)\n",
        "    x = layers.Conv2D(12, (3,3), activation=\"elu\", padding=\"same\")(x)\n",
        "    x = layers.Conv2D(12, (3,3), activation=None, padding=\"same\")(x)\n",
        "    x = layers.BatchNormalization(momentum=0.99, epsilon=0.001)(x)\n",
        "    x = layers.Activation(\"elu\")(x)\n",
        "    x = layers.MaxPooling2D((5,5), padding=\"same\")(x)\n",
        "    x = layers.Flatten()(x)\n",
        "    x = layers.Dropout(0.3)(x)\n",
        "    outputs = layers.Dense(1, activation=\"sigmoid\")(x)\n",
        "    return keras.Model(inputs, outputs, name=\"baseline_cnn\")\n",
        "\n",
        "print(\"params:\", build_baseline_cnn().count_params(), \"(your slides say 7,345)\")\n"
      ]
