        "# ===== CELL 2: config + helpers =====\n",
        "RESULTS = f\"{DRIVE}/results_v2.csv\"       # NEW file; your original CSV is untouched\n",
        "EPOCHS = 15            # target-adaptation epochs (same as before)\n",
        "BATCH = 8\n",
        "PRETRAIN_EPOCHS = 10   # report says 10 epochs. LR and batch size below are ASSUMED (see sanity-check cell)\n",
        "PRETRAIN_LR = 1e-3\n",
        "PRETRAIN_BATCH = 8\n",
        "SRC_PATH = {b: f\"{DRIVE}/source_model_{b}.weights.h5\" for b in BM}   # iccad3 = your existing file\n",
        "\n",
        "TARGETS = [\"iccad1\", \"iccad2\", \"iccad4\", \"iccad5\"]\n",
        "BUDGETS = [0.05, 0.10, 0.20]\n",
        "SEEDS_A = list(range(10))      # Phase A: ICCAD-3 source, 10 seeds\n",
        "SEEDS_C = list(range(5))       # Phase C: augmentation\n",
        "GRID_BUDGETS = [0.05, 0.20]    # Phase B: full grid\n",
        "GRID_SEEDS = list(range(5))\n",
        "\n",
        "# same subset sampler as your notebook (seeds 0-2 reproduce exactly the same subsets as before)\n",
        "def make_budget_subset(X, y, fraction, seed):\n",
        "    rng = np.random.RandomState(seed)\n",
        "    hs_idx = np.where(y == 1)[0]\n",
        "    nhs_idx = np.where(y == 0)[0]\n",
        "    n_hs = int(round(len(hs_idx) * fraction))\n",
        "    n_nhs = int(round(len(nhs_idx) * fraction))\n",
        "    hs_sample = rng.choice(hs_idx, size=n_hs, replace=False)\n",
        "    nhs_sample = rng.choice(nhs_idx, size=n_nhs, replace=False)\n",
        "    idx = np.concatenate([hs_sample, nhs_sample])\n",
        "    rng.shuffle(idx)\n",
        "    return X[idx], y[idx]\n",
        "\n",
        "# Hotspot oversampling by the 8 symmetries of a square (4 rotations x optional mirror).\n",
        "# Assumption: hotspot behaviour is roughly invariant to these transforms. Applied to TRAIN subsets only.\n",
        "def dihedral_variants(X):\n",
        "    outs = []\n",
        "    for k in range(4):\n",
        "        r = np.rot90(X, k, axes=(1, 2))\n",
        "        for flip in (False, True):\n",
        "            if k == 0 and not flip:\n",
        "                continue                      # skip identity\n",
        "            outs.append(np.ascontiguousarray(r[:, :, ::-1, :] if flip else r))\n",
        "    return np.concatenate(outs)\n",
        "\n",
        "def augment_hotspots(X, y):\n",
        "    hs = X[y == 1]\n",
        "    if len(hs) == 0:\n",
        "        return X, y\n",
        "    extra = dihedral_variants(hs)\n",
        "    return np.concatenate([X, extra]), np.concatenate([y, np.ones(len(extra), dtype=y.dtype)])\n",
        "\n",
        "# freeze_conv freezes only Conv2D layers. BatchNorm + Dense stay trainable (this is what \"head-only\" has meant in your runs)\n",
        "METHODS = {\n",
        "    \"scratch\":          dict(pre=False, freeze=False, lr=1e-3, aug=False),\n",
        "    \"head_only\":        dict(pre=True,  freeze=True,  lr=1e-3, aug=False),  # as originally reported\n",
        "    \"head_only_lr1e-4\": dict(pre=True,  freeze=True,  lr=1e-4, aug=False),  # LR-matched to full FT (ablation control)\n",
        "    \"adapted\":          dict(pre=True,  freeze=False, lr=1e-4, aug=False),  # full fine-tuning, as originally reported\n",
        "    \"scratch_aug\":      dict(pre=False, freeze=False, lr=1e-3, aug=True),\n",
        "    \"adapted_aug\":      dict(pre=True,  freeze=False, lr=1e-4, aug=True),\n",
        "}\n",
        "\n",
        "def get_model(weights=None, freeze_conv=False):\n",
        "    m = build_baseline_cnn()\n",
        "    if weights:\n",
        "        m.load_weights(weights)\n",
        "    if freeze_conv:\n",
        "        for l in m.layers:\n",
        "            if \"conv2d\" in l.name.lower():\n",
        "                l.trainable = False\n",
        "    return m\n",
        "\n",
        "def predict_counts(model, X, y):\n",
        "    p = model.predict(X, batch_size=1024, verbose=0).reshape(-1)\n",
        "    yp = (p > 0.5).astype(int)\n",
        "    tp = int(((y == 1) & (yp == 1)).sum()); fn = int(((y == 1) & (yp == 0)).sum())\n",
        "    fp = int(((y == 0) & (yp == 1)).sum()); tn = int(((y == 0) & (yp == 0)).sum())\n",
        "    return tn, fp, fn, tp\n",
        "\n",
        "def metrics_from_counts(tn, fp, fn, tp):\n",
        "    rec = tp / (tp + fn) if (tp + fn) else 0.0\n",
        "    spec = tn / (tn + fp) if (tn + fp) else 0.0\n",
        "    prec = tp / (tp + fp) if (tp + fp) else 0.0\n",
        "    f1 = 2 * tp / (2 * tp + fp + fn) if (2 * tp + fp + fn) else 0.0\n",
        "    return dict(balanced_acc=(rec + spec) / 2, specificity=spec, recall=rec, precision=prec, f1=f1)\n",
        "\n",
        "COLS = [\"source\", \"target\", \"budget_pct\", \"seed\", \"method\", \"n_train\", \"n_hs_train\",\n",
        "        \"tn\", \"fp\", \"fn\", \"tp\", \"balanced_acc\", \"specificity\", \"recall\", \"precision\", \"f1\"]\n",
        "\n",
        "def load_done():\n",
        "    if os.path.exists(RESULTS):\n",
        "        d = pd.read_csv(RESULTS)\n",
        "        return set(zip(d.source, d.target, d.budget_pct, d.seed, d.method))\n",
        "    return set()\n",
        "DONE = load_done()\n",
        "\n",
        "def log(row):\n",
        "    pd.DataFrame([row], columns=COLS).to_csv(RESULTS, mode=\"a\", header=not os.path.exists(RESULTS), index=False)\n",
        "    DONE.add((row[\"source\"], row[\"target\"], row[\"budget_pct\"], row[\"seed\"], row[\"method\"]))\n",
        "\n",
        "def cleanup(model):\n",
        "    del model\n",
        "    keras.backend.clear_session()\n",
        "    gc.collect()\n",
        "\n",
        "def run_zero_shot(source, target):\n",
        "    Xt, yt = get_split(target, \"test\")\n",
        "    m = get_model(SRC_PATH[source])\n",
        "    tn, fp, fn, tp = predict_counts(m, Xt, yt)\n",
        "    cleanup(m)\n",
        "    log(dict(source=source, target=target, budget_pct=0, seed=-1, method=\"zero_shot\", n_train=0, n_hs_train=0,\n",
        "             tn=tn, fp=fp, fn=fn, tp=tp, **metrics_from_counts(tn, fp, fn, tp)))\n",
        "\n",
        "def run_train(source, target, frac, seed, method):\n",
        "    cfg = METHODS[method]\n",
        "    X, y = get_split(target, \"train\")\n",
        "    Xs, ys = make_budget_subset(X, y, frac, seed)\n",
        "    n_hs = int(ys.sum())                       # hotspots BEFORE augmentation\n",
        "    if cfg[\"aug\"]:\n",
        "        Xs, ys = augment_hotspots(Xs, ys)\n",
        "    Xt, yt = get_split(target, \"test\")\n",
        "    keras.utils.set_random_seed(seed)          # seeds python, numpy and TF -> init, dropout, shuffling\n",
        "    m = get_model(SRC_PATH[source] if cfg[\"pre\"] else None, cfg[\"freeze\"])\n",
        "    m.compile(optimizer=keras.optimizers.Nadam(learning_rate=cfg[\"lr\"]), loss=\"binary_crossentropy\")\n",
        "    m.fit(Xs, ys, epochs=EPOCHS, batch_size=min(BATCH, len(Xs)), verbose=0)\n",
        "    tn, fp, fn, tp = predict_counts(m, Xt, yt)\n",
        "    cleanup(m)\n",
        "    log(dict(source=source if cfg[\"pre\"] else \"none\", target=target, budget_pct=int(round(frac * 100)),\n",
        "             seed=seed, method=method, n_train=len(Xs), n_hs_train=n_hs,\n",
        "             tn=tn, fp=fp, fn=fn, tp=tp, **metrics_from_counts(tn, fp, fn, tp)))\n",
        "\n",
        "def job_key(j):\n",
        "    kind, source, target, frac, seed, method = j\n",
        "    if kind == \"zs\":\n",
        "        return (source, target, 0, -1, \"zero_shot\")\n",
        "    return (source if METHODS[method][\"pre\"] else \"none\", target, int(round(frac * 100)), seed, method)\n",
        "\n",
        "def run_jobs(jobs, label=\"\"):\n",
        "    seen, todo = set(), []\n",
        "    for j in jobs:\n",
        "        k = job_key(j)\n",
        "        if k not in DONE and k not in seen:\n",
        "            seen.add(k); todo.append(j)\n",
        "    print(f\"{label}: {len(todo)} to run, {len(jobs) - len(todo)} already done/duplicate\")\n",
        "    t0 = time.time()\n",
        "    for i, j in enumerate(todo, 1):\n",
        "        if j[0] == \"zs\":\n",
        "            run_zero_shot(j[1], j[2])\n",
        "        else:\n",
        "            run_train(*j[1:])\n",
        "        if i % 5 == 0 or i == len(todo):\n",
        "            el = time.time() - t0\n",
        "            print(f\"  [{i}/{len(todo)}] {el/60:.1f} min elapsed, ~{el/i*(len(todo)-i)/60:.0f} min left\")\n",
        "    print(f\"{label}: finished. Results in {RESULTS}\")\n",
        "\n",
        "def pretrain_source(src, path=None, force=False):\n",
        "    path = path or SRC_PATH[src]\n",
        "    if os.path.exists(path) and not force:\n",
        "        print(f\"{src}: weights already exist -> {os.path.basename(path)}\")\n",
        "        return path\n",
        "    X, y = get_split(src, \"train\"); Xt, yt = get_split(src, \"test\")\n",
        "    keras.utils.set_random_seed(0)\n",
        "    m = build_baseline_cnn()\n",
        "    m.compile(optimizer=keras.optimizers.Nadam(learning_rate=PRETRAIN_LR), loss=\"binary_crossentropy\")\n",
        "    m.fit(X, y, epochs=PRETRAIN_EPOCHS, batch_size=min(PRETRAIN_BATCH, len(X)), verbose=0)\n",
        "    tn, fp, fn, tp = predict_counts(m, Xt, yt)\n",
        "    mt = metrics_from_counts(tn, fp, fn, tp)\n",
        "    print(f\"{src} pretrained: own-test BA={mt['balanced_acc']:.3f} spec={mt['specificity']:.3f} recall={mt['recall']:.3f}\")\n",
        "    m.save_weights(path)\n",
        "    cleanup(m)\n",
        "    return path\n"
      ]
    },
