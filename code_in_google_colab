        "# ===== CELL 8: ANALYSIS - tables + figures from whatever is in results_v2.csv (safe to run at any time) =====\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = pd.read_csv(RESULTS)\n",
        "M = [\"balanced_acc\", \"specificity\", \"recall\", \"precision\", \"f1\"]\n",
        "tr = df[df.method != \"zero_shot\"]\n",
        "A = tr[tr.source.isin([\"iccad3\", \"none\"]) & tr.target.isin(TARGETS)]\n",
        "print(\"runs logged:\", len(df), \"| seeds per condition (min):\", A.groupby([\"target\", \"budget_pct\", \"method\"]).size().min())\n",
        "\n",
        "# ---- 1. Summary table (mean/std over seeds), ICCAD-3 source ----\n",
        "g = A.groupby([\"target\", \"budget_pct\", \"method\"])\n",
        "summ = g[M].agg([\"mean\", \"std\"])\n",
        "summ.columns = [f\"{a}_{b}\" for a, b in summ.columns]\n",
        "summ[\"n_runs\"] = g.size()\n",
        "summ.round(4).to_csv(f\"{DRIVE}/summary_iccad3_source.csv\")\n",
        "print(\"\\nMean specificity / balanced accuracy at 20% budget:\")\n",
        "print(A[A.budget_pct == 20].pivot_table(index=\"target\", columns=\"method\", values=[\"specificity\", \"balanced_acc\"],\n",
        "                                         aggfunc=\"mean\").round(3))\n",
        "\n",
        "# ---- 2. Ablation, LR-matched ----\n",
        "ab = A[(A.budget_pct == 20) & A.method.isin([\"head_only\", \"head_only_lr1e-4\", \"adapted\"])]\n",
        "t_ab = ab.groupby([\"target\", \"method\"]).balanced_acc.agg([\"mean\", \"std\", \"count\"]).round(3)\n",
        "print(\"\\nAblation at 20% (head_only is LR 1e-3, head_only_lr1e-4 and adapted are LR 1e-4):\")\n",
        "print(t_ab)\n",
        "\n",
        "# ---- 3. Fig 1: BA vs budget ----\n",
        "colors = {\"scratch\": \"#d62728\", \"head_only\": \"#ff7f0e\", \"adapted\": \"#2ca02c\"}\n",
        "names = {\"scratch\": \"Scratch\", \"head_only\": \"Head-only FT\", \"adapted\": \"Full FT\"}\n",
        "fig, axes = plt.subplots(1, 4, figsize=(20, 5), sharey=True)\n",
        "zs = df[(df.method == \"zero_shot\") & (df.source == \"iccad3\")].set_index(\"target\")\n",
        "for ax, t in zip(axes, TARGETS):\n",
        "    for m in [\"scratch\", \"head_only\", \"adapted\"]:\n",
        "        d = A[(A.target == t) & (A.method == m)].groupby(\"budget_pct\").balanced_acc.agg([\"mean\", \"std\"]).reset_index()\n",
        "        if len(d):\n",
        "            ax.errorbar(d.budget_pct, d[\"mean\"], yerr=d[\"std\"], marker=\"o\", capsize=4, lw=2, color=colors[m], label=names[m])\n",
        "    if t in zs.index:\n",
        "        ax.axhline(zs.loc[t, \"balanced_acc\"], ls=\"--\", color=\"#1f77b4\", label=\"Zero-shot\")\n",
        "    ax.set_title(t.upper().replace(\"ICCAD\", \"ICCAD-\")); ax.set_xticks([5, 10, 20]); ax.set_ylim(0.45, 1.02)\n",
        "    ax.set_xlabel(\"Target training data used (%)\"); ax.grid(alpha=.3)\n",
        "axes[0].set_ylabel(\"Balanced accuracy\"); axes[0].legend(loc=\"lower right\", fontsize=9)\n",
        "n_seeds = A.groupby([\"target\", \"budget_pct\", \"method\"]).size().min()\n",
        "plt.suptitle(f\"Balanced accuracy vs target budget (source ICCAD-3, mean ± std over {n_seeds} seeds)\", y=1.03)\n",
        "plt.tight_layout(); plt.savefig(f\"{DRIVE}/fig1_adaptation_curves_v2.png\", dpi=200, bbox_inches=\"tight\"); plt.show()\n",
        "\n",
        "# ---- 4. Fig 2: confusion matrices from the SAME runs as the tables (seed 0, 20% budget) ----\n",
        "fig, axes = plt.subplots(2, 4, figsize=(18, 9))\n",
        "for col, t in enumerate(TARGETS):\n",
        "    for row, m in enumerate([\"scratch\", \"adapted\"]):\n",
        "        r = A[(A.target == t) & (A.budget_pct == 20) & (A.seed == 0) & (A.method == m)]\n",
        "        if r.empty:\n",
        "            continue\n",
        "        r = r.iloc[0]; cm = np.array([[r.tn, r.fp], [r.fn, r.tp]]); ax = axes[row, col]\n",
        "        ax.imshow(cm, cmap=\"Blues\")\n",
        "        for i in range(2):\n",
        "            for j in range(2):\n",
        "                ax.text(j, i, str(cm[i, j]), ha=\"center\", va=\"center\", fontsize=12, fontweight=\"bold\",\n",
        "                        color=\"white\" if cm[i, j] > cm.max() / 2 else \"black\")\n",
        "        ax.set_xticks([0, 1]); ax.set_xticklabels([\"Pred NHS\", \"Pred HS\"])\n",
        "        ax.set_yticks([0, 1]); ax.set_yticklabels([\"Actual NHS\", \"Actual HS\"])\n",
        "        ax.set_title(f\"{t.upper().replace('ICCAD','ICCAD-')} - {'Scratch' if m=='scratch' else 'Adapted'}\\nBA={r.balanced_acc:.3f}\")\n",
        "plt.suptitle(\"Confusion matrices at 20% budget (seed 0): scratch vs adapted\", y=1.0)\n",
        "plt.tight_layout(); plt.savefig(f\"{DRIVE}/fig2_confusion_v2.png\", dpi=200, bbox_inches=\"tight\"); plt.show()\n",
        "\n",
        "# ---- 5. Augmentation comparison (same seeds 0-4 for every method) ----\n",
        "aug = tr[(tr.seed < 5) & tr.target.isin(TARGETS) & tr.source.isin([\"iccad3\", \"none\"]) &\n",
        "         tr.method.isin([\"scratch\", \"scratch_aug\", \"adapted\", \"adapted_aug\"])]\n",
        "if aug.method.isin([\"scratch_aug\", \"adapted_aug\"]).any():\n",
        "    print(\"\\nAugmentation (mean BA over seeds 0-4):\")\n",
        "    print(aug.pivot_table(index=[\"target\", \"budget_pct\"], columns=\"method\", values=\"balanced_acc\", aggfunc=\"mean\").round(3))\n",
        "\n",
        "# ---- 6. Transfer matrices (source rows x target cols) ----\n",
        "def heat(ax, mat, title):\n",
        "    mat = mat.reindex(index=BM, columns=BM)\n",
        "    ax.imshow(mat.values.astype(float), vmin=0.5, vmax=1.0, cmap=\"viridis\")\n",
        "    for i in range(5):\n",
        "        for j in range(5):\n",
        "            v = mat.values[i, j]\n",
        "            if pd.notna(v):\n",
        "                ax.text(j, i, f\"{v:.2f}\", ha=\"center\", va=\"center\", color=\"w\" if v < .8 else \"k\", fontsize=10)\n",
        "    ax.set_xticks(range(5)); ax.set_xticklabels([b.replace(\"iccad\", \"\") for b in BM])\n",
        "    ax.set_yticks(range(5)); ax.set_yticklabels([b.replace(\"iccad\", \"\") for b in BM])\n",
        "    ax.set_xlabel(\"target ICCAD-\"); ax.set_ylabel(\"source ICCAD-\"); ax.set_title(title)\n",
        "\n",
        "zsm = df[df.method == \"zero_shot\"].pivot_table(index=\"source\", columns=\"target\", values=\"balanced_acc\")\n",
        "adm = df[(df.method == \"adapted\") & (df.budget_pct == 20) & (df.source != \"none\")].pivot_table(\n",
        "    index=\"source\", columns=\"target\", values=\"balanced_acc\")\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
        "heat(axes[0], zsm, \"Zero-shot balanced accuracy\"); heat(axes[1], adm, \"Full FT @20% balanced accuracy (mean over seeds)\")\n",
        "plt.tight_layout(); plt.savefig(f\"{DRIVE}/fig3_transfer_matrices.png\", dpi=200, bbox_inches=\"tight\"); plt.show()\n",
        "print(\"\\nSaved summary_iccad3_source.csv, fig1/fig2/fig3 PNGs to Drive.\")\n"
